  "findings": {
    "F0001": {
      "statement": "DenseRetrievalConfig.__post_init__ validates embedding_model, embedding_dimensions, and candidate_limit, then calls physical_index_name(index_schema_version, \"dense-query\") to enforce the schema-version naming contract without issuing a mapping request.",
      "sources": [
        "S0001"
      ],
      "uncertain": false
    },
    "F0002": {
      "statement": "DenseRetrievalConfig.from_settings maps Settings fields cohere_embed_model, cohere_embed_dimensions, opensearch_index_schema_version, and opensearch_dense_candidate_limit into the config.",
      "sources": [
        "S0001"
      ],
      "uncertain": false
    },
    "F0003": {
      "statement": "normalize_dense_query trims and collapses internal whitespace via \" \".join(query_text.split()) and raises ValueError for non-string input.",
      "sources": [
        "S0001"
      ],
      "uncertain": false
    },
    "F0004": {
      "statement": "OpenSearchDenseRetriever.__init__ validates base_url and read_alias as nonblank strings and checks the embedding_provider has an embed attribute.",
      "sources": [
        "S0001"
      ],
      "uncertain": false
    },
    "F0005": {
      "statement": "OpenSearchDenseRetriever.search validates tenant_id is a UUID and collection_id is a UUID when present, builds RetrievalFilters, and normalizes the query.",
      "sources": [
        "S0001"
      ],
      "uncertain": false
    },
    "F0006": {
      "statement": "When the normalized query is empty, search returns an empty DenseRetrievalResponse with zero candidate_count and zero elapsed timings, short-circuiting embedding and OpenSearch calls.",
      "sources": [
        "S0001"
      ],
      "uncertain": false
    },
    "F0007": {
      "statement": "search calls embedding_provider.embed with an EmbeddingRequest of one normalized query and EmbeddingPurpose.QUERY, timing it with time.perf_counter.",
      "sources": [
        "S0001"
      ],
      "uncertain": false
    },
    "F0008": {
      "statement": "_query_vector rejects results with purpose other than QUERY, more than one vector, model mismatch, or dimensions mismatch, raising RetrievalError with codes embedding_invalid_response, embedding_model_mismatch, and query_vector_dimensions_mismatch.",
      "sources": [
        "S0001"
      ],
      "uncertain": false
    },
    "F0009": {
      "statement": "_query_vector also rejects vectors containing non-numeric, boolean, or non-finite values with RetrievalError embedding_invalid_response, then coerces values to float.",
      "sources": [
        "S0001"
      ],
      "uncertain": false
    },
    "F0010": {
      "statement": "_search_body builds a k-NN query with size and k set to candidate_limit, track_total_hits true, explain set to debug, an explicit _source list of chunk and document fields, and a bool filter using filters.clauses().",
      "sources": [
        "S0001"
      ],
      "uncertain": false
    },
    "F0011": {
      "statement": "search issues POST /{read_alias}/_search with the constructed body via _request and parses payload['hits']['hits'], raising RetrievalError opensearch_invalid_response when the payload, hits, or hits.hits shapes are unexpected.",
      "sources": [
        "S0001"
      ],
      "uncertain": false
    },
    "F0012": {
      "statement": "search reuses OpenSearchBM25Retriever._result_from_hit and _candidate_count to convert hits into RetrievalResult objects and derive candidate_count, so dense and BM25 share the normalized result contract.",
      "sources": [
        "S0001"
      ],
      "uncertain": false
    },
    "F0013": {
      "statement": "_request creates a per-call httpx.AsyncClient with a 10s timeout, translating httpx.HTTPError into RetrievalError opensearch_unavailable retryable=True and mapping HTTP status >=500, 408, or 429 to retryable errors.",
      "sources": [
        "S0001"
      ],
      "uncertain": false
    },
    "F0014": {
      "statement": "_candidate_limit defaults to config.candidate_limit when limit is None, validates limit is a positive non-bool int, and otherwise caps it at min(limit, config.candidate_limit).",
      "sources": [
        "S0001"
      ],
      "uncertain": false
    },
    "F0015": {
      "statement": "DenseRetrievalTrace records normalized_query, model/dimensions, adapter, schema version, read_alias, candidate counts, per-stage elapsed milliseconds, tenant_id, collection_id, and filter values, keeping diagnostics separate from evidence.",
      "sources": [
        "S0001"
      ],
      "uncertain": false
    },
    "F0016": {
      "statement": "The module's CLI main parses query, --tenant (required UUID), --collection, and --limit, then runs _debug_query via asyncio.run; _debug_query opens configured_cohere_embeddings as a context manager, constructs a retriever from settings, and searches with debug=True.",
      "sources": [
        "S0001"
      ],
      "uncertain": false
    }
  },

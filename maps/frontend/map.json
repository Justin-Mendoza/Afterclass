  "findings": {
    "F0001": {
      "statement": "The frontend Dockerfile builds a Next.js dev server: CMD runs `npm run dev -- --hostname 0.0.0.0`, listening on port 3000 (EXPOSE 3000) rather than a production `next start`.",
      "sources": [
        "S0001",
        "S0002"
      ],
      "uncertain": false
    },
    "F0002": {
      "statement": "Dockerfile installs dependencies reproducibly with `npm ci` from package.json and package-lock.json before copying the rest of the source (COPY . .).",
      "sources": [
        "S0001"
      ],
      "uncertain": false
    },
    "F0003": {
      "statement": "package.json defines the frontend as the Next.js app `hybrid-rag-search-web` (v0.1.0), pinning Node engine >=22 <23 and Next ^16 with React/React-DOM ^19.",
      "sources": [
        "S0002"
      ],
      "uncertain": false
    },
    "F0004": {
      "statement": "npm scripts expose dev (next dev), build (next build), start (next start), lint (eslint . --max-warnings=0), typecheck (tsc --noEmit), test (vitest run), and Prettier format/format:check commands.",
      "sources": [
        "S0002"
      ],
      "uncertain": false
    },
    "F0005": {
      "statement": "RootLayout in src/app/layout.tsx is the App Router root component: it imports ./styles.css, exports Metadata (title \"Hybrid RAG Search\") and renders children inside <html lang=\"en\"><body>.",
      "sources": [
        "S0006"
      ],
      "uncertain": false
    },
    "F0006": {
      "statement": "Home in src/app/page.tsx is the index route component, rendering a static placeholder with an eyebrow \"Hybrid RAG Search\", an h1 \"Evidence-first answers, built for inspection.\", and a paragraph about the search workspace awaiting its first collection.",
      "sources": [
        "S0008"
      ],
      "uncertain": false
    },
    "F0007": {
      "statement": "page.test.tsx renders the Home component with @testing-library/react and asserts via screen.getByRole that the level-1 heading text equals \"Evidence-first answers, built for inspection.\"\u2014the only supplied runtime test of a UI entry point.",
      "sources": [
        "S0007",
        "S0008"
      ],
      "uncertain": false
    },
    "F0008": {
      "statement": "Vitest is configured to use the jsdom test environment with the @vitejs/plugin-react plugin, enabling React component tests such as page.test.tsx.",
      "sources": [
        "S0010",
        "S0007"
      ],
      "uncertain": false
    },
    "F0009": {
      "statement": "next.config.ts sets reactStrictMode: true and agentRules: false as the NextConfig; no rewrites, redirects, or API proxying are declared in this excerpt.",
      "sources": [
        "S0005"
      ],
      "uncertain": false
    },
    "F0010": {
      "statement": "tsconfig.json enables strict TypeScript with jsx \"react-jsx\", moduleResolution \"bundler\", next plugin, and a `@/*` path alias to ./src/*, including generated .next/types and .next/dev/types.",
      "sources": [
        "S0009"
      ],
      "uncertain": false
    },
    "F0011": {
      "statement": "next-env.d.ts references next and next/image-types/global types and imports generated route/root-param types from ./.next/dev/types, indicating use of Next's dev-generated route typing.",
      "sources": [
        "S0004"
      ],
      "uncertain": false
    },
    "F0012": {
      "statement": "ESLint uses flat config via defineConfig, composing eslint-config-next core-web-vitals and typescript presets and ignoring .next/**, coverage/**, and next-env.d.ts.",
      "sources": [
        "S0003"
      ],
      "uncertain": false
    },
    "F0013": {
      "statement": "The supplied frontend sources contain no fetch, HTTP client, API route handler, database access, or environment-variable reading; no runtime connection between this frontend and the backend/retrieval/answers subsystems is observable here.",
      "sources": [
        "S0008",
        "S0006"
      ],
      "uncertain": false
    },
    "F0014": {
      "statement": "The index page renders only static text with no user input controls, state, event handlers, or async data loading, so no user actions beyond viewing are implemented in this batch.",
      "sources": [
        "S0008"
      ],
      "uncertain": false
    },
    "F0015": {
      "statement": "The context lists dependencies [answers, foundation, retrieval], but no import or call to those subsystems appears in the supplied frontend excerpts, so that relationship is not demonstrated by this source batch.",
      "sources": [
        "S0002",
        "S0008"
      ],
      "uncertain": true
    }

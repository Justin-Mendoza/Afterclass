  "findings": {
    "F0001": {
      "statement": "chunk_document groups ParsedDocument.blocks by locator.heading_path via itertools.groupby and chunks each section separately, so a chunk never spans a heading change; chunk order resumes at len(chunks)+1 for each section.",
      "sources": [
        "S0002"
      ],
      "uncertain": false
    },
    "F0002": {
      "statement": "_chunk_section greedily accumulates whole ParsedBlocks while the candidate embedding token count stays within config.max_tokens, then appends the resulting Chunk.",
      "sources": [
        "S0002"
      ],
      "uncertain": false
    },
    "F0003": {
      "statement": "When a whole block does not fit, _largest_fitting_prefix performs a binary search over token spans to find the largest prefix whose embedding token count fits, then splits the remaining block text (skipping leading whitespace) into the next pending fragment.",
      "sources": [
        "S0002"
      ],
      "uncertain": false
    },
    "F0004": {
      "statement": "_candidate raises ChunkingError if fragments have differing heading_paths or if fragments is empty, enforcing the no-cross-heading-boundary invariant at candidate construction.",
      "sources": [
        "S0002"
      ],
      "uncertain": false
    },
    "F0005": {
      "statement": "After emitting a chunk, _chunk_section computes carry via _trailing_overlap using config.overlap_tokens, re-attaching trailing content fragments for the next chunk's overlap.",
      "sources": [
        "S0002"
      ],
      "uncertain": false
    },
    "F0006": {
      "statement": "_trailing_overlap tokenizes the joined content_text (fragments separated by '\\n\\n') and maps the token start offset back into per-fragment local character ranges to build overlap fragments.",
      "sources": [
        "S0002"
      ],
      "uncertain": false
    },
    "F0007": {
      "statement": "build_embedding_text prepends Markdown-style headings ('#' * level) reconstructed from heading_path before the body, and strips a leading heading block that duplicates heading_path[-1] to avoid embedding it twice.",
      "sources": [
        "S0004"
      ],
      "uncertain": false
    },
    "F0008": {
      "statement": "build_embedding_text raises ValueError if content_text is blank, if heading_path is not a tuple of nonblank strings, or if leading_heading_block does not match the leaf heading or is not first in content_text.",
      "sources": [
        "S0004"
      ],
      "uncertain": false
    },
    "F0009": {
      "statement": "The _Candidate.token_count is computed with tokenizer.tokenize applied to the embedding_text (including heading context), not the raw content_text, so the token limit accounts for enrichment.",
      "sources": [
        "S0002"
      ],
      "uncertain": false
    },
    "F0010": {
      "statement": "ChunkingConfig.version is a stable_digest of a canonical JSON serialization of algorithm, embedding_limit_tokens, max_tokens, overlap_tokens, tokenizer model/revision/sha256, prefixed with 'chunkcfg_'.",
      "sources": [
        "S0003"
      ],
      "uncertain": false
    },
    "F0011": {
      "statement": "ChunkingConfig.__post_init__ validates positive max_tokens, nonnegative overlap_tokens strictly less than max_tokens, max_tokens not exceeding embedding_limit_tokens, nonblank string labels, and a lowercase 64-hex tokenizer_sha256.",
      "sources": [
        "S0003"
      ],
      "uncertain": false
    },
    "F0012": {
      "statement": "Chunk.chunk_id is determined by stable_digest over document_id, config_version, order, content_text, embedding_text, and each span's canonical_value, prefixed with 'chk_'.",
      "sources": [
        "S0003"
      ],
      "uncertain": false
    },
    "F0013": {
      "statement": "Chunk.__post_init__ enforces document_id matching 'doc_[0-9a-f]{64}', config_version matching 'chunkcfg_[0-9a-f]{64}', nonblank content/embedding text, positive order and embedding_token_count, and nonempty source_spans ordered by (block_number, start_char, end_char).",
      "sources": [
        "S0003"
      ],
      "uncertain": false
    },
    "F0014": {
      "statement": "stable_digest hashes a versioned namespace header plus length-prefixed UTF-8 fields with SHA-256; DocumentContentIdentity.document_id derives from tenant_id, collection_id, and content_sha256 via stable_digest('document', ...) producing 'doc_<digest>'.",
      "sources": [
        "S0005"
      ],
      "uncertain": false
    },
    "F0015": {
      "statement": "A chunking module docstring 'Deterministic structure-aware document chunking' is the __init__ surface for the chunking package; the actual implementation symbols live in chunker/contracts/embedding_text/identity modules.",
      "sources": [
        "S0001",
        "S0002",
        "S0003",
        "S0004",
        "S0005"
      ],
      "uncertain": false
    },
    "F0016": {
      "statement": "chunker.py imports build_embedding_text, ParsedBlock/ParsedDocument, TextTokenizer, and chunking contracts, but the excerpts do not show a top-level call site invoking chunk_document at runtime; wiring into ingestion pipeline is inferred from the changed-files list only.",
      "sources": [
        "S0002"
      ],
      "uncertain": true
    }
  },

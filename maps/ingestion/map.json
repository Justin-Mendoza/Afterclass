  "findings": {
    "F0001": {
      "statement": "chunk_document is the package's public entry point: it takes a document_id, a ParsedDocument, a TextTokenizer, and an optional ChunkingConfig (defaulting to DEFAULT_CHUNKING_CONFIG) and returns a tuple of Chunk records.",
      "sources": [
        "S0002",
        "S0003"
      ],
      "uncertain": false
    },
    "F0002": {
      "statement": "chunk_document groups parsed blocks with itertools.groupby keyed on block.locator.heading_path, then delegates each section to _chunk_section, so chunking is performed section-by-section and a chunk never crosses a heading boundary.",
      "sources": [
        "S0002"
      ],
      "uncertain": false
    },
    "F0003": {
      "statement": "_candidate enforces the heading-boundary invariant by raising ChunkingError when fragments in one candidate carry differing heading_path values.",
      "sources": [
        "S0002"
      ],
      "uncertain": false
    },
    "F0004": {
      "statement": "_chunk_section greedily appends whole blocks to the current candidate while _candidate's token count stays within config.max_tokens, then emits a Chunk via _make_chunk with order = first_order + len(chunks).",
      "sources": [
        "S0002"
      ],
      "uncertain": false
    },
    "F0005": {
      "statement": "When a block does not fit, _largest_fitting_prefix performs a binary search over the block's token spans (using TextTokenizer.tokenize) to find the largest prefix that keeps the candidate within max_tokens, and the split remainder is reseeded as the next pending fragment.",
      "sources": [
        "S0002"
      ],
      "uncertain": false
    },
    "F0006": {
      "statement": "After emitting a chunk with remaining pending blocks, _trailing_overlap computes carry fragments from the last config.overlap_tokens tokens of the candidate's content text, seeding the next candidate; overlap is suppressed when no pending blocks remain.",
      "sources": [
        "S0002"
      ],
      "uncertain": false
    },
    "F0007": {
      "statement": "ChunkingConfig in contracts.py validates max_tokens (positive), overlap_tokens (nonnegative and less than max_tokens), embedding_limit_tokens (positive, and max_tokens must not exceed it), nonblank tokenizer/algorithm strings, and a 64-hex tokenizer_sha256.",
      "sources": [
        "S0003"
      ],
      "uncertain": false
    },
    "F0008": {
      "statement": "ChunkingConfig.version canonicalizes the algorithm, embedding_limit_tokens, max_tokens, overlap_tokens, tokenizer model/revision/sha256 via sorted-key JSON and returns a chunkcfg_-prefixed stable_digest, so any of these values changing produces a new config version.",
      "sources": [
        "S0003",
        "S0005"
      ],
      "uncertain": false
    },
    "F0009": {
      "statement": "stable_digest builds a SHA-256 over a versioned namespace header plus length-prefixed UTF-8 fields, which is the shared identity primitive used for config versions, document IDs, and chunk IDs.",
      "sources": [
        "S0005"
      ],
      "uncertain": false
    },
    "F0010": {
      "statement": "DocumentContentIdentity.document_id derives a doc_-prefixed identity from tenant_id, collection_id, and content_sha256, and Chunk validates document_id against the doc_[0-9a-f]{64} pattern.",
      "sources": [
        "S0005",
        "S0003"
      ],
      "uncertain": false
    },
    "F0011": {
      "statement": "Chunk.chunk_id is a chk_-prefixed stable_digest over document_id, config_version, order, content_text, embedding_text, and each source span's canonical_value, making chunk identity content-addressed and rebuildable.",
      "sources": [
        "S0003"
      ],
      "uncertain": false
    },
    "F0012": {
      "statement": "Chunk.__post_init__ requires nonempty source_spans, rejects spans whose (block_number, start_char, end_char) positions are not in source order, and validates document_id, config_version, order, and nonblank content/embedding text.",
      "sources": [
        "S0003"
      ],
      "uncertain": false
    },
    "F0013": {
      "statement": "build_embedding_text reconstructs Markdown headings ('#' * level + heading) from heading_path and joins them to the body, dropping a duplicated leading heading block by recognizing it as the content prefix; this produces the enriched embedding_text stored separately from content_text.",
      "sources": [
        "S0004",
        "S0002"
      ],
      "uncertain": false
    },
    "F0014": {
      "statement": "_candidate computes embedding_text via build_embedding_text and sets token_count from len(tokenizer.tokenize(embedding_text)), so token budgeting is measured against the enriched embedding text rather than raw content.",
      "sources": [
        "S0002",
        "S0004"
      ],
      "uncertain": false
    },
    "F0015": {
      "statement": "_make_chunk raises ChunkingError when the candidate's embedding_token_count is not positive, and _chunk_section raises ChunkingError when heading context plus a single source token cannot fit in the token limit.",
      "sources": [
        "S0002"
      ],
      "uncertain": false
    },
    "F0016": {
      "statement": "The chunking package __init__ docstring describes the subsystem as 'Deterministic structure-aware document chunking', but the specific symbols it re-exports are not shown in the supplied source.",
      "sources": [
        "S0001"
      ],
      "uncertain": true
    }
  },
